[Unit]
Description=Agni AI rag-backend (shared brain: answers, lead capture)
After=network-online.target
Wants=network-online.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/ACT-Voice-Assistant/rag-backend
ExecStart=/home/azureuser/ACT-Voice-Assistant/rag-backend/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
