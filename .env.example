# Copy to .env (never commit .env). Names only; fill the values locally.
SARVAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
RAG_BACKEND_AUTH_KEY=
RAG_BACKEND_PUBLIC_URL=
ERP_URL=
ERP_API_KEY=
VOICE_PIPELINE_DIR=C:\ACT-Voice-Assistant\voice-pipeline
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
PHONE_PUBLIC_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=
CALLS_SHEET_ID=
RECEPTION_PHONE=
ADMISSIONS_PHONE=
PLACEMENT_PHONE=
ERP_TEST_CALLER=
CALL_MAX_MINUTES=15
ENABLE_TEST_PAGE=1                 # 0 on any server the public can reach
PHONE_STT_RATE=8000                # 8000 or 16000: what Sarvam listening receives
PHONE_NUDGE_SECS=10               # quiet-caller nudge delay (a second nudge, then goodbye, follows)
CALLS_SHEET_TAB=Calls              # tab in CALLS_SHEET_ID for the post-call records
PHONE_BACKGROUND=quiet_office       # off = no background sound; or set PHONE_BACKGROUND_FILE to your own 8 kHz mono WAV
PHONE_BACKGROUND_VOLUME=0.15
